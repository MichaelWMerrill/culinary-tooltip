---
/*
 * RecipeLayout — renders a `recipes` collection entry with Recipe JSON-LD.
 *
 * Every number on the page comes from somewhere already published: cook time
 * from stallEngine.cookDuration() on the entry's registry protein, pulled
 * yield and servings from that protein's yield matrix, ingredient amounts from
 * the entry's own ratios. The JSON-LD is computed from the same values at the
 * default weight, and those default-weight values are what the page renders
 * before any script runs, so the structured data matches the visible content.
 *
 * The weight slider is recipe-local: it rescales the amounts on this page and
 * the calculator deep link, never writes to the URL or localStorage, and never
 * mounts YieldCalculator (which owns its own h1 and share-link wiring).
 */
import Layout from './Layout.astro';
import { AUTHOR_NAME, AUTHOR_ROLE, AUTHOR_SCHEMA } from '../utils/author.js';
import { PROTEINS } from '../utils/proteinRegistry.js';
import { pickRelatedPosts } from '../utils/relatedContent.js';
import {
  recipeCookHours,
  isoDuration,
  formatDuration,
  ingredientGrams,
  recipeYield,
  calculatorHref,
} from '../utils/recipeModel.js';
import { unknownSourceIds, unsupportedApprovedClaims, pendingWithoutSource } from '../utils/recipeSources.js';

const { recipe, relatedPosts: allPosts = [] } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroAlt,
  calculator,
  modelProtein,
  modelVersion,
  defaults,
  sources = [],
  ratios,
  guidance,
  steps,
} = recipe;

const protein = PROTEINS[modelProtein];
// A recipe's printed times are only valid against the model version it was
// written for; a registry bump must be a deliberate recipe review, not a
// silent change to published numbers.
if (protein.meta.version !== modelVersion) {
  throw new Error(`Recipe "${title}" was written against ${modelProtein} v${modelVersion}, registry is v${protein.meta.version}.`);
}
const pending = ratios.filter((r) => r.review === 'pending').map((r) => r.id);
const pendingGuidance = guidance.filter((g) => g.review === 'pending').map((g) => g.id);
if (pending.length || pendingGuidance.length) {
  console.warn(`[recipe] "${title}" has items pending science-editor review: ${[...pending, ...pendingGuidance].join(', ')}`);
}

// Source-citation rules (src/utils/recipeSources.js): a bad reference or an
// approved-but-uncited claim fails the build; a pending claim with no source
// yet is only a second log line, alongside the warning above.
const badRefs = unknownSourceIds(recipe);
if (badRefs.length) {
  throw new Error(`Recipe "${title}" references unknown source id(s): ${badRefs.join(', ')}`);
}
const unsupported = unsupportedApprovedClaims(recipe);
if (unsupported.length) {
  throw new Error(`Recipe "${title}" has review:approved item(s) with no source or model basis: ${unsupported.join(', ')}`);
}
const pendingNoSource = pendingWithoutSource(recipe);
if (pendingNoSource.length) {
  console.warn(`[recipe] "${title}" pending item(s) with no source yet: ${pendingNoSource.join(', ')}`);
}

// Stall-predictor route per registry protein (existing pages only).
const STALL_URLS = { beef_brisket: '/stall-predictor', pork_shoulder: '/pork-shoulder-stall', turkey: '/turkey-stall' };

const weightAxis = protein.yield.axes.find((a) => a.id === 'weight');
const cutAxis = protein.yield.axes.find((a) => a.id === 'cut');
const cutLabel = cutAxis?.options.find((o) => o.value === defaults.cut)?.label ?? '';
const w = defaults.weight;

const cookHours = recipeCookHours(protein, defaults, w);
const { pulledLb, servings } = recipeYield(protein, defaults, w);
const meatLine = (weight) => `${weight} lb ${cutLabel.toLowerCase()} ${protein.meta.name.toLowerCase()}`;
const ingredientLines = ratios.map((r) => ({ ...r, grams: ingredientGrams(r.pct, w) }));
const WRAP_LABEL = { naked: 'unwrapped', paper: 'wrapped in butcher paper', foil: 'wrapped in foil' };
const PIT_LABEL = { offset_smoker: 'an offset smoker', pellet_cooker: 'a pellet cooker', ceramic_kamado: 'a ceramic kamado', charcoal_kettle: 'a charcoal kettle' };
const wrapClause = defaults.wrap === 'naked' ? 'left unwrapped' : `${WRAP_LABEL[defaults.wrap]} at ${defaults.wrapTemp}°F internal`;
const assumptions = `Times assume ${PIT_LABEL[defaults.pit]} at ${defaults.pitTemp}°F in ${defaults.climate} weather, ${wrapClause}.`;

const relatedPosts = pickRelatedPosts(allPosts, recipe.protein[0]);
const calcHref = calculatorHref(calculator, protein, defaults, w);
const stallHref = STALL_URLS[modelProtein];
const restHref = `/rest-calculator?pr=${modelProtein}`;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const ogUrl = 'https://empiricalbbq.com' + (Astro.url?.pathname ?? '/recipes').replace(/\.html$/, '');
const absHero = heroImage ? (heroImage.startsWith('http') ? heroImage : 'https://empiricalbbq.com' + heroImage) : undefined;
const isoDate = new Date(pubDate).toISOString().slice(0, 10);
const isoUpdated = updatedDate ? new Date(updatedDate).toISOString().slice(0, 10) : undefined;

const recipeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: title,
  description,
  // Only a real image; no og-default fallback for the Recipe image.
  ...(absHero ? { image: absHero } : {}),
  author: AUTHOR_SCHEMA,
  datePublished: isoDate,
  dateModified: isoUpdated ?? isoDate,
  recipeYield: `${servings} servings`,
  // cookTime only: the model covers smoker time, not the dry-brine hold or the
  // rest, so a totalTime would understate the real start-to-serve time.
  cookTime: isoDuration(cookHours),
  recipeIngredient: [meatLine(w), ...ingredientLines.map((r) => `${r.grams} g ${r.label.toLowerCase()}`)],
  recipeInstructions: steps.map((s) => ({ '@type': 'HowToStep', text: s.text })),
  mainEntityOfPage: ogUrl,
  publisher: {
    '@type': 'Organization',
    name: 'Empirical BBQ',
    url: 'https://empiricalbbq.com/',
    logo: 'https://empiricalbbq.com/android-chrome-512x512.png',
  },
};

// Client config: only what the slider needs to recompute on this page.
const clientConfig = JSON.stringify({
  protein: modelProtein,
  calculator,
  defaults,
  ratios: ratios.map((r) => ({ id: r.id, pct: r.pct })),
  cutLabel,
});
---

<Layout
  title={`Empirical BBQ | ${title}`}
  description={description}
  ogUrl={ogUrl}
  {...(absHero ? { ogImage: absHero } : {})}
  schema={recipeSchema}
  bodyClass="page-recipe min-h-screen flex flex-col bg-base-850 text-base-300 font-display antialiased selection:bg-flame-500/30"
  showBanner={false}
>
  <div class="relative z-10 flex-1 w-full">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <article class="pb-16 pt-8" data-recipe={clientConfig}>
        <header class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-widest text-flame-400 mb-3">Empirical BBQ · Recipe</p>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.1]">{title}</h1>
          <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm">
            <span class="text-base-400">
              By <a href="/about" rel="author" class="font-semibold text-flame-400 hover:text-flame-300 transition-colors">{AUTHOR_NAME}</a>
              <span class="text-base-500"> · {AUTHOR_ROLE}</span>
            </span>
            <span class="text-base-500 font-mono text-xs">{formattedDate}</span>
          </div>
          <p class="mt-4 text-lg text-base-400 leading-relaxed">{description}</p>
        </header>

        {
          heroImage && (
            <img
              src={heroImage}
              alt={heroAlt ?? title}
              loading="eager"
              class="w-full rounded-2xl ring-1 ring-base-700 shadow-xl shadow-black/40 mb-10 aspect-[16/9] object-cover"
            />
          )
        }

        <!-- Default-weight summary: these are the values in the Recipe JSON-LD. -->
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
          <div class="rounded-xl bg-base-800/60 ring-1 ring-base-700 p-3">
            <dt class="text-[11px] font-semibold uppercase tracking-widest text-base-500">Raw weight</dt>
            <dd class="mt-1 text-lg font-bold text-white"><span data-recipe-out="weight">{w}</span> lb</dd>
          </div>
          <div class="rounded-xl bg-base-800/60 ring-1 ring-base-700 p-3">
            <dt class="text-[11px] font-semibold uppercase tracking-widest text-base-500">Smoker time</dt>
            <dd class="mt-1 text-lg font-bold text-white" data-recipe-out="cook">{formatDuration(cookHours)}</dd>
          </div>
          <div class="rounded-xl bg-base-800/60 ring-1 ring-base-700 p-3">
            <dt class="text-[11px] font-semibold uppercase tracking-widest text-base-500">Pulled meat</dt>
            <dd class="mt-1 text-lg font-bold text-white"><span data-recipe-out="pulled">{pulledLb.toFixed(1)}</span> lb</dd>
          </div>
          <div class="rounded-xl bg-base-800/60 ring-1 ring-base-700 p-3">
            <dt class="text-[11px] font-semibold uppercase tracking-widest text-base-500">Yield</dt>
            <dd class="mt-1 text-lg font-bold text-white"><span data-recipe-out="servings">{servings}</span> servings</dd>
          </div>
        </dl>
        <p class="text-xs text-base-500 leading-relaxed mb-8">
          {assumptions} Smoker time does not include the dry brine or the rest. Pulled weight and servings come from the
          <a href={calcHref} data-recipe-out="calc-link" class="text-flame-400 hover:text-flame-300 underline underline-offset-2">yield calculator</a>
          (model v{protein.meta.version}, about {protein.serving.lbPerGuestCooked.toFixed(2)} lb per serving).
        </p>

        <section class="rounded-2xl bg-base-800/60 ring-1 ring-base-700 p-5 sm:p-6 mb-10" aria-labelledby="recipe-ingredients-heading">
          <h2 id="recipe-ingredients-heading" class="text-xl font-extrabold text-white">Ingredients</h2>
          <label for="recipe-weight" class="mt-4 flex flex-col gap-0.5 text-sm font-medium text-base-300 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
            <span>{weightAxis.label} (out of the package, before trimming)</span>
            <span class="font-mono text-white shrink-0"><span data-recipe-out="weight">{w}</span> lb</span>
          </label>
          <input
            id="recipe-weight"
            type="range"
            min={weightAxis.range.min}
            max={weightAxis.range.max}
            step={weightAxis.range.step}
            value={w}
            class="mt-2 w-full accent-orange-500"
          />
          <p class="mt-2 text-xs text-base-500">
            Amounts below are for an {w} lb shoulder. Move the slider to your weight and the numbers on this page change with it.
          </p>
          <ul class="mt-5 divide-y divide-base-700/70">
            <li class="flex items-baseline justify-between gap-4 py-2.5">
              <span class="text-base-300">{protein.meta.name} ({cutLabel.toLowerCase()})</span>
              <span class="font-mono font-semibold text-white"><span data-recipe-out="weight">{w}</span> lb</span>
            </li>
            {
              ingredientLines.map((r) => (
                <li class="flex items-baseline justify-between gap-4 py-2.5" data-review={r.review}>
                  <span class="text-base-300">{r.label}</span>
                  <span class="font-mono font-semibold text-white">
                    <span data-recipe-grams={r.id}>{r.grams}</span> g
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        <div class="post-body">
          <slot />
        </div>

        <section class="mt-10" aria-labelledby="recipe-steps-heading">
          <h2 id="recipe-steps-heading" class="text-2xl font-extrabold text-white pb-2 border-b border-base-700">Steps</h2>
          <ol class="mt-6 space-y-6">
            {
              steps.map((s, i) => (
                <li class="flex gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-flame-500/15 ring-1 ring-flame-500/40 text-sm font-bold text-flame-300">
                    {i + 1}
                  </span>
                  <div>
                    <p class="text-base-300 leading-relaxed">{s.text}</p>
                    {s.timing === 'model' && (
                      <p class="mt-1.5 text-sm font-semibold text-white">
                        Model estimate: about <span data-recipe-out="cook">{formatDuration(cookHours)}</span> for <span data-recipe-out="weight">{w}</span> lb.
                      </p>
                    )}
                    <p class="mt-1.5 text-sm text-base-400 leading-relaxed">
                      <span class="font-semibold text-flame-400">Why:</span> {s.why}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        {
          guidance.length > 0 && (
            <aside class="mt-10 rounded-2xl bg-base-800/60 ring-1 ring-base-700 p-5 sm:p-6" aria-labelledby="recipe-guidance-heading">
              <h2 id="recipe-guidance-heading" class="text-[11px] font-semibold uppercase tracking-widest text-flame-400 mb-2.5">
                Rules of thumb (guidance, not a measured result)
              </h2>
              <ul class="space-y-2 text-sm text-base-400 leading-relaxed">
                {guidance.map((g) => (
                  <li data-review={g.review}>{g.text}</li>
                ))}
              </ul>
            </aside>
          )
        }

        <section class="mt-10 grid gap-3 sm:grid-cols-3" aria-label="Related tools">
          <a href={calcHref} data-recipe-out="calc-link" class="rounded-2xl bg-base-800/60 ring-1 ring-base-700 hover:ring-flame-500/50 p-4 transition-all group">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-flame-400 mb-1">Yield &amp; cost</p>
            <p class="text-sm font-semibold text-white group-hover:text-flame-300">Open this cook in the calculator</p>
          </a>
          <a href={stallHref} class="rounded-2xl bg-base-800/60 ring-1 ring-base-700 hover:ring-flame-500/50 p-4 transition-all group">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-flame-400 mb-1">Your smoker</p>
            <p class="text-sm font-semibold text-white group-hover:text-flame-300">Run your own pit and weather</p>
          </a>
          <a href={restHref} class="rounded-2xl bg-base-800/60 ring-1 ring-base-700 hover:ring-flame-500/50 p-4 transition-all group">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-flame-400 mb-1">Rest &amp; hold</p>
            <p class="text-sm font-semibold text-white group-hover:text-flame-300">See how long your hold stays safe</p>
          </a>
        </section>

        {
          relatedPosts.length > 0 && (
            <section class="mt-10" aria-labelledby="recipe-reading-heading">
              <h2 id="recipe-reading-heading" class="text-[11px] font-semibold uppercase tracking-widest text-flame-400 mb-3">
                Field notes on this cut
              </h2>
              <ul class="space-y-2">
                {relatedPosts.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}`} class="text-sm font-semibold text-base-300 hover:text-flame-300 underline decoration-dotted underline-offset-2">
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          sources.length > 0 && (
            <section class="mt-10" aria-labelledby="recipe-sources-heading">
              <h2 id="recipe-sources-heading" class="text-[11px] font-semibold uppercase tracking-widest text-flame-400 mb-3">
                Sources
              </h2>
              <ul class="space-y-1.5 text-sm text-base-400">
                {sources.map((s) => (
                  <li>
                    <a href={s.url} rel="noopener" class="text-base-300 hover:text-flame-300 underline decoration-dotted underline-offset-2">
                      {s.title}
                    </a>
                    {' · '}{s.publisher}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <aside class="mt-12 rounded-2xl bg-base-800/60 ring-1 ring-base-700 p-5 sm:p-6">
          <p class="text-[11px] font-semibold uppercase tracking-widest text-flame-400 mb-2.5">About the author</p>
          <p class="text-sm text-base-400 leading-relaxed">
            <a href="/about" rel="author" class="font-bold text-white hover:text-flame-300 transition-colors">{AUTHOR_NAME}</a>
            is the {AUTHOR_ROLE.replace(/^Creator of /, 'creator of ')}. The cook times and yields on this page come from the
            site's published models, and every constant behind them is listed on the
            <a href="/methodology" class="text-flame-400 hover:text-flame-300 underline underline-offset-2">methodology page</a>.
          </p>
        </aside>
      </article>
    </div>
  </div>

  <footer class="relative z-10 border-t border-base-700 bg-base-900/70 backdrop-blur">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-medium text-base-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <a href="/about" class="hover:text-white transition-colors">About</a>
        <a href="/methodology" class="hover:text-white transition-colors">Methodology</a>
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
        <a href="/privacy" class="text-flame-400 hover:text-flame-300 transition-colors">Privacy Policy</a>
      </nav>
      <div class="pt-6 border-t border-base-800 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-xs text-base-500">&copy; 2026 Empirical BBQ · Pitmaster Science &amp; Mathematics Suite</p>
        <p class="text-[11px] text-base-600 font-mono">Estimates for planning only. Always probe to temperature.</p>
      </div>
    </div>
  </footer>
</Layout>

<script>
  import { PROTEINS } from '../utils/proteinRegistry.js';
  import { recipeCookHours, formatDuration, ingredientGrams, recipeYield, calculatorHref } from '../utils/recipeModel.js';

  // Recipe-local scaler: updates this page's numbers only. No writeParams, no
  // storage, and every lookup is scoped to the recipe root.
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-recipe]');
    const slider = root?.querySelector('#recipe-weight');
    if (!root || !slider) return;
    const cfg = JSON.parse(root.dataset.recipe);
    const protein = PROTEINS[cfg.protein];
    const set = (key, text) => root.querySelectorAll(`[data-recipe-out="${key}"]`).forEach((el) => (el.textContent = text));

    const render = () => {
      const w = Number(slider.value);
      const { pulledLb, servings } = recipeYield(protein, cfg.defaults, w);
      set('weight', String(w));
      set('cook', formatDuration(recipeCookHours(protein, cfg.defaults, w)));
      set('pulled', pulledLb.toFixed(1));
      set('servings', String(servings));
      const href = calculatorHref(cfg.calculator, protein, cfg.defaults, w);
      root.querySelectorAll('[data-recipe-out="calc-link"]').forEach((a) => a.setAttribute('href', href));
      for (const r of cfg.ratios) {
        const el = root.querySelector(`[data-recipe-grams="${r.id}"]`);
        if (el) el.textContent = String(ingredientGrams(r.pct, w));
      }
    };
    slider.addEventListener('input', render);
  });
</script>

<style is:global>
  body.page-recipe::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(1200px 600px at 82% -12%, rgba(249, 115, 22, 0.14), transparent 60%),
      radial-gradient(950px 520px at -8% 108%, rgba(245, 158, 11, 0.09), transparent 55%);
  }
  .page-recipe .post-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #aeb8d0;
  }
  .page-recipe .post-body > * + * {
    margin-top: 1.15rem;
  }
  .page-recipe .post-body h2 {
    color: #fff;
    font-size: 1.6rem;
    line-height: 1.25;
    font-weight: 800;
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #26314a;
  }
  .page-recipe .post-body a {
    color: #fb923c;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }
  .page-recipe .post-body strong {
    color: #fff;
  }
</style>
